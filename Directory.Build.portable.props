<!-- Early props only. Self-contained flags live in Directory.Build.portable.targets
     so they see the final $(OutputType) and do not apply to class libraries. -->
<Project>
  <PropertyGroup Condition="'$(FILES_PORTABLE_BUILD)' == 'true'">
    <DefineConstants>$(DefineConstants);FILES_PORTABLE</DefineConstants>
    <UseSatoriCoreLibOverride>false</UseSatoriCoreLibOverride>
    <UseSatoriNativeRuntimeOverride>false</UseSatoriNativeRuntimeOverride>
    <!-- Fix WMC9999: XamlCompiler.exe has a resource name mismatch when
         invoked as a subprocess by dotnet msbuild (Core runtime).
         Use the in-process XAML compiler instead (same as Visual Studio).
         See: https://github.com/microsoft/microsoft-ui-xaml/issues/11157 -->
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
  </PropertyGroup>
</Project>
